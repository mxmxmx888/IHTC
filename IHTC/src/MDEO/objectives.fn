using "./ihtc.mm"

// Counts scheduled patients.
fun admittedPatientsAmount(): int {
    return Admission.all().size()
}

// Penalises unscheduled patients, weighted toward mandatory patients.
fun unscheduledPatientsPenalty(): int {
    var penalty = 0
    var patients = Patient.all()

    for (patient in patients) {
        var matchingAdmissions = Admission.all().filter((admission) =>
            admission.patientId == patient
        )

        if (matchingAdmissions.size() == 0) {
            if (patient.isMandatory == true) {
                penalty = penalty + 1000
            } else {
                penalty = penalty + 100
            }
        }
    }

    return penalty
}

// Checks whether every mandatory patient is admitted.
fun mandatoryPatientsAdmitted(): boolean {
    for (patient in Patient.all()) {
        if (patient.isMandatory == true) {
            var admissions = Admission.all().filter((admission) =>
                admission.patientId == patient
            )

            if (admissions.size() == 0) {
                return false
            }
        }
    }

    return true
}

// Penalises invalid patient-to-nurse phase states.
fun nurseAssignmentPhaseConsistency(): int {
    var state = OptimisationState.first()

    if (state.phase == OptimisationPhase.PATIENTS) {
        return RoomShiftAssignment.all().size() + 1
    }

    var missingMandatoryAdmissions = 0

    for (patient in Patient.all()) {
        if (patient.isMandatory == true) {
            var admissions = Admission.all().filter((admission) =>
                admission.patientId == patient
            )

            if (admissions.size() == 0) {
                missingMandatoryAdmissions = missingMandatoryAdmissions + 1
            }
        }
    }

    return missingMandatoryAdmissions
}

// Sums room-day capacity excess.
fun roomCapacityViolation(): int {
    var totalCapacityViolation = 0
    var roomAvailabilities = RoomAvailability.all()

    for (roomAvailability in roomAvailabilities) {
        var room = roomAvailability.roomId
        var maxCapacity = room.maxCapacity
        var currentOccupancy = roomAvailability.occupiedBeds

        if (currentOccupancy > maxCapacity) {
            totalCapacityViolation = totalCapacityViolation + (currentOccupancy - maxCapacity)
        }
    }

    return totalCapacityViolation
}

// Counts mandatory patients without admissions.
fun removedPatients(): int {
    var removedCount = 0
    var patients = Patient.all()

    for (patient in patients) {
        if (patient.isMandatory == true) {
            var matchingAdmissions = Admission.all().filter((admission) =>
                admission.patientId == patient
            )

            if (matchingAdmissions.size() == 0) {
                removedCount = removedCount + 1
            }
        }
    }

    return removedCount
}

// Sums theatre operating-time capacity excess.
fun theatreCapacityViolation(): int {
    var totalCapacityViolation = 0
    var theatreAvailabilities = OperatingTheatreAvailability.all()

    for (theatreAvailability in theatreAvailabilities) {
        var day = theatreAvailability.day
        var theatre = theatreAvailability.operatingTheatreId
        var maxCapacity = theatreAvailability.maxCapacity

        var matchingAdmissions = Admission.all().filter((admission) =>
            admission.admissionDay == day &&
            admission.operationTheatreId == theatre
        )

        var dayCapacity = 0
        for (admission in matchingAdmissions) {
            dayCapacity = dayCapacity + admission.patientId.surgeryDuration
        }

        if (dayCapacity > maxCapacity) {
            totalCapacityViolation = totalCapacityViolation + (dayCapacity - maxCapacity)
        }
    }

    return totalCapacityViolation
}

// Sums surgeon operating-time capacity excess.
fun surgeonCapacityViolation(): int {
    var totalCapacityViolation = 0
    var surgeonAvailabilities = SurgeonAvailability.all()

    for (surgeonAvailability in surgeonAvailabilities) {
        var day = surgeonAvailability.day
        var surgeon = surgeonAvailability.surgeonId
        var maxOperatingTime = surgeonAvailability.maxOperatingTime

        var matchingAdmissions = Admission.all().filter((admission) =>
            admission.admissionDay == day &&
            admission.patientId.assignedSurgeonId == surgeon
        )

        var usedOperatingTime = 0
        for (admission in matchingAdmissions) {
            usedOperatingTime = usedOperatingTime + admission.patientId.surgeryDuration
        }

        if (usedOperatingTime > maxOperatingTime) {
            totalCapacityViolation = totalCapacityViolation + (usedOperatingTime - maxOperatingTime)
        }
    }

    return totalCapacityViolation
}

// Sums nurse skill shortfalls for assigned slots.
fun totalSkillLevelViolation(): int {
    var totalViolation = 0

    for (assignment in RoomShiftAssignment.all()) {
        var requiredSkill = 0
        var shift = assignment.hospitalisationShift

        for (demand in PatientDayDemand.all()) {
            var contributingAdmissions = Admission.all().filter((admission) =>
                admission.patientId == demand.patient &&
                admission.roomId == shift.room &&
                admission.admissionDay + demand.relativeDay == shift.day &&
                demand.shift == shift.shift
            )

            if (contributingAdmissions.size() > 0 && demand.skillLevelRequired > requiredSkill) {
                requiredSkill = demand.skillLevelRequired
            }
        }

        if (assignment.nurse.skillLevel < requiredSkill) {
            totalViolation = totalViolation + (requiredSkill - assignment.nurse.skillLevel)
        }
    }

    return totalViolation
}

// Counts active room-shift slots with nurse cover.
fun RoomShiftCoverage(): int {
    var coveredShiftCount = 0

    for (shift in HospitalisationShift.all()) {
        var workload = 0

        for (demand in PatientDayDemand.all()) {
            var contributingAdmissions = Admission.all().filter((admission) =>
                admission.patientId == demand.patient &&
                admission.roomId == shift.room &&
                admission.admissionDay + demand.relativeDay == shift.day &&
                demand.shift == shift.shift
            )

            if (contributingAdmissions.size() > 0) {
                workload = workload + demand.workloadProduced
            }
        }

        if (workload > 0) {
            var assignments = RoomShiftAssignment.all().filter((assignment) =>
                assignment.hospitalisationShift == shift
            )

            if (assignments.size() > 0) {
                coveredShiftCount = coveredShiftCount + 1
            }
        }
    }

    return coveredShiftCount
}

// Counts active room-shift slots without nurse cover.
fun uncoveredRoomShiftViolation(): int {
    var uncoveredShiftCount = 0

    for (shift in HospitalisationShift.all()) {
        var workload = 0

        for (demand in PatientDayDemand.all()) {
            var contributingAdmissions = Admission.all().filter((admission) =>
                admission.patientId == demand.patient &&
                admission.roomId == shift.room &&
                admission.admissionDay + demand.relativeDay == shift.day &&
                demand.shift == shift.shift
            )

            if (contributingAdmissions.size() > 0) {
                workload = workload + demand.workloadProduced
            }
        }

        if (workload > 0) {
            var assignments = RoomShiftAssignment.all().filter((assignment) =>
                assignment.hospitalisationShift == shift
            )

            if (assignments.size() == 0) {
                uncoveredShiftCount = uncoveredShiftCount + 1
            }
        }
    }

    return uncoveredShiftCount
}

// Sums workload on active room-shift slots without nurse cover.
fun uncoveredWorkloadViolation(): int {
    var totalUncoveredWorkload = 0

    for (shift in HospitalisationShift.all()) {
        var slotWorkload = 0

        for (demand in PatientDayDemand.all()) {
            var contributingAdmissions = Admission.all().filter((admission) =>
                admission.patientId == demand.patient &&
                admission.roomId == shift.room &&
                admission.admissionDay + demand.relativeDay == shift.day &&
                demand.shift == shift.shift
            )

            if (contributingAdmissions.size() > 0) {
                slotWorkload = slotWorkload + demand.workloadProduced
            }
        }

        var assignments = RoomShiftAssignment.all().filter((assignment) =>
            assignment.hospitalisationShift == shift
        )

        if (slotWorkload > 0 && assignments.size() == 0) {
            totalUncoveredWorkload = totalUncoveredWorkload + slotWorkload
        }
    }

    return totalUncoveredWorkload
}

// Sums admission delay after each patient's release date.
fun admissionDelayPenalty(): int {
    var totalDelay = 0

    for (admission in Admission.all()) {
        var delay = admission.admissionDay - admission.patientId.releaseDate

        if (delay > 0) {
            totalDelay = totalDelay + delay
        }
    }

    return totalDelay
}

// Counts nurse assignments on inactive room-shift slots.
fun inactiveRoomShiftAssignmentViolation(): int {
    var totalViolation = 0

    for (assignment in RoomShiftAssignment.all()) {
        var workload = 0
        var shift = assignment.hospitalisationShift

        for (demand in PatientDayDemand.all()) {
            var contributingAdmissions = Admission.all().filter((admission) =>
                admission.patientId == demand.patient &&
                admission.roomId == shift.room &&
                admission.admissionDay + demand.relativeDay == shift.day &&
                demand.shift == shift.shift
            )

            if (contributingAdmissions.size() > 0) {
                workload = workload + demand.workloadProduced
            }
        }

        if (workload == 0) {
            totalViolation = totalViolation + 1
        }
    }

    return totalViolation
}

// Returns workload variance across nurses.
fun NurseWorkloadDistributionInbalance(): double {
    var nurses = Nurse.all()
    var nurseCount = nurses.size()

    if (nurseCount == 0) {
        return 0.0
    }

    var totalWorkload = 0.0

    for (nurse in nurses) {
        var nurseLoad = 0.0
        var assignments = RoomShiftAssignment.all().filter((assignment) =>
            assignment.nurse == nurse
        )

        for (assignment in assignments) {
            var assignmentWorkload = 0
            var shift = assignment.hospitalisationShift

            for (demand in PatientDayDemand.all()) {
                var contributingAdmissions = Admission.all().filter((admission) =>
                    admission.patientId == demand.patient &&
                    admission.roomId == shift.room &&
                    admission.admissionDay + demand.relativeDay == shift.day &&
                    demand.shift == shift.shift
                )

                if (contributingAdmissions.size() > 0) {
                    assignmentWorkload = assignmentWorkload + demand.workloadProduced
                }
            }

            nurseLoad = nurseLoad + assignmentWorkload
        }

        totalWorkload = totalWorkload + nurseLoad
    }

    var meanWorkload = totalWorkload / nurseCount
    var varianceSum = 0.0

    for (nurse in nurses) {
        var nurseLoad = 0.0
        var assignments = RoomShiftAssignment.all().filter((assignment) =>
            assignment.nurse == nurse
        )

        for (assignment in assignments) {
            var assignmentWorkload = 0
            var shift = assignment.hospitalisationShift

            for (demand in PatientDayDemand.all()) {
                var contributingAdmissions = Admission.all().filter((admission) =>
                    admission.patientId == demand.patient &&
                    admission.roomId == shift.room &&
                    admission.admissionDay + demand.relativeDay == shift.day &&
                    demand.shift == shift.shift
                )

                if (contributingAdmissions.size() > 0) {
                    assignmentWorkload = assignmentWorkload + demand.workloadProduced
                }
            }

            nurseLoad = nurseLoad + assignmentWorkload
        }

        var difference = nurseLoad - meanWorkload
        varianceSum = varianceSum + (difference * difference)
    }

    return varianceSum / nurseCount
}

// Sums nurse workload excess and invalid working-shift assignments.
fun totalWorkloadViolation(): int {
    var totalViolation = 0

    for (workingShift in NurseWorkingShift.all()) {
        var currentLoad = 0
        var assignments = RoomShiftAssignment.all().filter((assignment) =>
            assignment.nurse == workingShift.nurse &&
            assignment.hospitalisationShift.day == workingShift.day &&
            assignment.hospitalisationShift.shift == workingShift.shift
        )

        for (assignment in assignments) {
            var assignmentWorkload = 0
            var shift = assignment.hospitalisationShift

            for (demand in PatientDayDemand.all()) {
                var contributingAdmissions = Admission.all().filter((admission) =>
                    admission.patientId == demand.patient &&
                    admission.roomId == shift.room &&
                    admission.admissionDay + demand.relativeDay == shift.day &&
                    demand.shift == shift.shift
                )

                if (contributingAdmissions.size() > 0) {
                    assignmentWorkload = assignmentWorkload + demand.workloadProduced
                }
            }

            currentLoad = currentLoad + assignmentWorkload
        }

        if (currentLoad > workingShift.maxLoad) {
            totalViolation = totalViolation + (currentLoad - workingShift.maxLoad)
        }
    }

    for (assignment in RoomShiftAssignment.all()) {
        var shift = assignment.hospitalisationShift
        var matchingWorkingShifts = NurseWorkingShift.all().filter((workingShift) =>
            workingShift.nurse == assignment.nurse &&
            workingShift.day == shift.day &&
            workingShift.shift == shift.shift
        )

        if (matchingWorkingShifts.size() == 0) {
            var assignmentWorkload = 0

            for (demand in PatientDayDemand.all()) {
                var contributingAdmissions = Admission.all().filter((admission) =>
                    admission.patientId == demand.patient &&
                    admission.roomId == shift.room &&
                    admission.admissionDay + demand.relativeDay == shift.day &&
                    demand.shift == shift.shift
                )

                if (contributingAdmissions.size() > 0) {
                    assignmentWorkload = assignmentWorkload + demand.workloadProduced
                }
            }

            totalViolation = totalViolation + assignmentWorkload
        }
    }

    return totalViolation
}

// Returns room-day occupancy standard deviation.
fun roomOccupancyStandardDeviation(): double {
    var roomAvailabilities = RoomAvailability.all()
    var availabilityCount = roomAvailabilities.size()

    if (availabilityCount == 0) {
        return 0.0
    }

    var totalOccupancy = 0.0
    for (roomAvailability in roomAvailabilities) {
        totalOccupancy = totalOccupancy + roomAvailability.occupiedBeds
    }

    var meanOccupancy = totalOccupancy / availabilityCount
    var varianceSum = 0.0

    for (roomAvailability in roomAvailabilities) {
        var diff = roomAvailability.occupiedBeds - meanOccupancy
        varianceSum = varianceSum + (diff * diff)
    }

    var variance = varianceSum / availabilityCount

    if (variance == 0.0) {
        return 0.0
    }

    var guess = variance
    var i = 0

    while (i < 20) {
        guess = 0.5 * (guess + (variance / guess))
        i = i + 1
    }

    return guess
}
